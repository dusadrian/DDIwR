+// Defer R conditions until libxml2 has released its temporary parser buffers.
+struct ParseError {
+  xmlError error;
+  ParseError* next;
+};
+
+struct ParseContext {
+  xmlParserCtxtPtr parser;
+  SEXP output;
+  const char* path;
+  const char* bytes;
+  int size;
+  const char* encoding;
+  const char* base_url;
+  bool as_html;
+  int options;
+  ParseError* errors;
+  ParseError* last_error;
+  bool out_of_memory;
+};
+
+static void release_parser(ParseContext* context) {
+  if (context->parser == NULL) {
+    return;
+  }
+  if (context->parser->myDoc != NULL) {
+    xmlFreeDoc(context->parser->myDoc);
+    context->parser->myDoc = NULL;
+  }
+  if (context->as_html) {
+    htmlFreeParserCtxt(context->parser);
+  } else {
+    xmlFreeParserCtxt(context->parser);
+  }
+  context->parser = NULL;
+}
+
+static void cleanup_parse(void* data, Rboolean) {
+  ParseContext* context = static_cast<ParseContext*>(data);
+  release_parser(context);
+  while (context->errors != NULL) {
+    ParseError* error = context->errors;
+    context->errors = error->next;
+    xmlResetError(&error->error);
+    free(error);
+  }
+}
+
+#if LIBXML_VERSION >= 21200
+static void capture_parse_error(void* data, const xmlError* error) {
+#else
+static void capture_parse_error(void* data, xmlError* error) {
+#endif
+#if LIBXML_VERSION >= 21300
+  ParseContext* context = static_cast<ParseContext*>(data);
+#else
+  xmlParserCtxtPtr parser = static_cast<xmlParserCtxtPtr>(data);
+  ParseContext* context = static_cast<ParseContext*>(parser->_private);
+#endif
+  ParseError* record = static_cast<ParseError*>(calloc(1, sizeof(ParseError)));
+  if (record == NULL || xmlCopyError(const_cast<xmlError*>(error), &record->error) != 0) {
+    if (record != NULL) {
+      xmlResetError(&record->error);
+      free(record);
+    }
+    context->out_of_memory = true;
+    xmlStopParser(context->parser);
+    return;
+  }
+  if (context->last_error == NULL) {
+    context->errors = record;
+  } else {
+    context->last_error->next = record;
+  }
+  context->last_error = record;
+  if (error->level > XML_ERR_ERROR) {
+    xmlStopParser(context->parser);
+  }
+}
+
+static SEXP parse_document(void* data) {
+  ParseContext* context = static_cast<ParseContext*>(data);
+  context->parser = context->as_html ? htmlNewParserCtxt() : xmlNewParserCtxt();
+  if (context->parser == NULL) {
+    Rf_error("Failed to allocate XML parser context");
+  }
+
+#if LIBXML_VERSION >= 21300
+  xmlCtxtSetErrorHandler(context->parser, capture_parse_error, context);
+#else
+  context->parser->_private = context;
+  context->parser->sax->serror = capture_parse_error;
+#endif
+
+  xmlDoc* document;
+  if (context->path != NULL) {
+    document = context->as_html ?
+      htmlCtxtReadFile(context->parser, context->path, context->encoding, context->options) :
+      xmlCtxtReadFile(context->parser, context->path, context->encoding, context->options);
+  } else {
+    document = context->as_html ?
+      htmlCtxtReadMemory(context->parser, context->bytes, context->size,
+        context->base_url, context->encoding, context->options) :
+      xmlCtxtReadMemory(context->parser, context->bytes, context->size,
+        context->base_url, context->encoding, context->options);
+  }
+
+  // The R pointer owns any returned document before warnings can become errors.
+  R_SetExternalPtrAddr(context->output, document);
+  context->parser->myDoc = NULL;
+  release_parser(context);
+
+  if (context->out_of_memory) {
+    Rf_error("Failed to allocate XML parser diagnostic");
+  }
+  for (ParseError* error = context->errors; error != NULL; error = error->next) {
+    char* message = error->error.message;
+    if (message == NULL) {
+      message = const_cast<char*>("XML parsing failed");
+    } else {
+      size_t length = strlen(message);
+      if (length > 0 && message[length - 1] == '\n') {
+        message[length - 1] = '\0';
+      }
+    }
+    if (error->error.level <= XML_ERR_ERROR) {
+      Rf_warning("%s [%i]", message, error->error.code);
+    } else {
+      Rf_error("%s [%i]", message, error->error.code);
+    }
+  }
+  if (document == NULL) {
+    if (context->path != NULL) {
+      Rf_error("Failed to parse %s", context->path);
+    }
+    Rf_error("Failed to parse text");
+  }
+  return context->output;
+}
