options nosyntaxcheck nofmterr;
libname incoming "%sysget(HOME)" access=readonly;
libname evidence "%sysget(HOME)/ddiwr_actual_diagnostic";
data work.value_checks;
    merge work.expected_rows(rename=(number=e_number day=e_day moment=e_moment clock=e_clock text=e_text))
        work.actual_rows;
    by row_id;
    array expected[4] e_number e_day e_moment e_clock;
    array actual[4] number day moment clock;
    retain finite_differences missing_differences character_differences 0;
    do index=1 to 4;
        if missing(expected[index]) then missing_differences+(expected[index] ne actual[index]);
        else finite_differences+(expected[index] ne actual[index]);
    end;
    character_differences+(e_text ne text);
run;
data evidence.interoperability_summary;
    length check $48 status $8 detail $140;
    set work.value_checks end=last;
    if last then do;
        check='Finite numeric/date/time values'; status=ifc(finite_differences=0,'PASS','FAIL');
        detail=cats(finite_differences,' differences across 16 finite values'); output;
        check='Character values, including Unicode'; status=ifc(character_differences=0,'PASS','FAIL');
        detail=cats(character_differences,' differences across 32 strings'); output;
        check='System and extended missing values'; status=ifc(missing_differences=0,'PASS','FAIL');
        detail=cats(missing_differences,' differences across 112 missing values'); output;
    end;
    keep check status detail;
run;
data work.additional_checks;
    length check $48 status $8 detail $140;
    check='DDIwR-generated catalog';
    valid=cexist('incoming.mixed_20261020_012855'); status=ifc(valid,'PASS','FAIL');
    detail='PROC CATALOG and PROC FORMAT reject the exported file'; output;
    check='SAS-native catalog control';
    valid=cexist('evidence.reference'); status=ifc(valid,'PASS','FAIL');
    detail='SAS-created catalog reopened; 12 definitions extracted'; output;
    check='Empty dataset'; dsid=open('incoming.empty_20261020_012855','I');
    if dsid then do; count=attrn(dsid,'NLOBS'); rc=close(dsid); end;
    else count=-1;
    status=ifc(count=0,'PASS','FAIL'); detail=cats(count,' observations'); output;
    keep check status detail;
run;
proc append base=evidence.interoperability_summary data=work.additional_checks; run;
data work.narrow_values; set incoming.narrow_20261020_012855; format _all_; run;
data work.narrow_check;
    length check $48 status $8 detail $140;
    retain failures 0;
    set work.narrow_values end=last;
    if row_id=1 then failures+(number ne 4097 or day ne 3653);
    else if row_id=2 then failures+(number ne 0 or day ne 3654);
    else failures+1;
    if last then do;
        check='Three-byte numeric/date values'; status=ifc(failures=0,'PASS','FAIL');
        detail=cats(failures,' differences; PROC CONTENTS confirms length 3'); output;
    end;
    keep check status detail;
run;
proc append base=evidence.interoperability_summary data=work.narrow_check; run;
title "Actual SAS interoperability: &sysvlong4 / &sysscp / %sysfunc(getoption(encoding))";
proc print data=evidence.interoperability_summary noobs; run;
title;
