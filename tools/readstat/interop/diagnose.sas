proc printto; run;
options source source2 nosyntaxcheck nofmterr;
%let root=%sysget(HOME);
data _null_; path=dcreate('ddiwr_actual_diagnostic',"&root"); run;
libname incoming "&root" access=readonly;
libname evidence "&root/ddiwr_actual_diagnostic";
%let syscc=0;
%let failures=0;
%macro record(message);
    %let failures=%eval(&failures+1);
    %put ERROR: DDIWR_DIAGNOSTIC_FAIL &message;
%mend;
%macro compare_rows(base,actual,variables);
    proc sort data=&base; by row_id; run;
    proc sort data=&actual; by row_id; run;
    proc compare base=&base compare=&actual criterion=0 method=absolute;
        id row_id; var &variables;
    run;
    %if &sysinfo >= 64 %then %record(Values differ SYSINFO=&sysinfo);
    %else %put DDIWR_RAW_VALUES_PASS &actual SYSINFO=&sysinfo;
%mend;
%put DDIWR_ACTUAL_SAS_VERSION=&sysvlong4;
%put DDIWR_ACTUAL_SAS_PLATFORM=&sysscp &sysscpl;
%put DDIWR_ACTUAL_SAS_ENCODING=%sysfunc(getoption(encoding));
/* First create and reopen a native SAS catalog using the same LIBRARY syntax. */
proc format library=evidence.reference;
    value REFDATE -1='Before SAS epoch' 0='SAS epoch' 3653='R epoch'
        .='System missing' ._='Underscore missing' .A='Missing A' .Z='Missing Z';
    value $REFTEXT '01'='ZeroOne' ' A'='Leading' 'é'='Accent' '漢字'='Unicode' ' '='Blank';
run;
proc format library=evidence.reference cntlout=evidence.reference_labels; run;
data evidence.reference;
    length text $40; informat day date9.; format day REFDATE. text $REFTEXT.;
    day=3653; text='01'; output; day=.; text=' '; output;
    day=._; text=' A'; output; day=.A; text='é'; output; day=.Z; text='漢字'; output;
run;
data work.expected_rows;
    length text $40;
    row_id=1; number=-2.5; day=-1; moment=-0.125; clock=-0.125; text='01'; output;
    row_id=2; number=0; day=0; moment=0; clock=0; text='1'; output;
    row_id=3; number=1.25; day=3653; moment=315619200; clock=1.25; text=' A'; output;
    row_id=4; number=42; day=24107; moment=2082844800.125; clock=90000.5; text='é'; output;
    row_id=5; number=.; day=.; moment=.; clock=.; text='漢字'; output;
    row_id=6; number=._; day=._; moment=._; clock=._; text=''; output;
    row_id=7; number=.A; day=.A; moment=.A; clock=.A; text='01'; output;
    row_id=8; number=.B; day=.B; moment=.B; clock=.B; text='1'; output;
    row_id=9; number=.C; day=.C; moment=.C; clock=.C; text=' A'; output;
    row_id=10; number=.D; day=.D; moment=.D; clock=.D; text='é'; output;
    row_id=11; number=.E; day=.E; moment=.E; clock=.E; text='漢字'; output;
    row_id=12; number=.F; day=.F; moment=.F; clock=.F; text=''; output;
    row_id=13; number=.G; day=.G; moment=.G; clock=.G; text='01'; output;
    row_id=14; number=.H; day=.H; moment=.H; clock=.H; text='1'; output;
    row_id=15; number=.I; day=.I; moment=.I; clock=.I; text=' A'; output;
    row_id=16; number=.J; day=.J; moment=.J; clock=.J; text='é'; output;
    row_id=17; number=.K; day=.K; moment=.K; clock=.K; text='漢字'; output;
    row_id=18; number=.L; day=.L; moment=.L; clock=.L; text=''; output;
    row_id=19; number=.M; day=.M; moment=.M; clock=.M; text='01'; output;
    row_id=20; number=.N; day=.N; moment=.N; clock=.N; text='1'; output;
    row_id=21; number=.O; day=.O; moment=.O; clock=.O; text=' A'; output;
    row_id=22; number=.P; day=.P; moment=.P; clock=.P; text='é'; output;
    row_id=23; number=.Q; day=.Q; moment=.Q; clock=.Q; text='漢字'; output;
    row_id=24; number=.R; day=.R; moment=.R; clock=.R; text=''; output;
    row_id=25; number=.S; day=.S; moment=.S; clock=.S; text='01'; output;
    row_id=26; number=.T; day=.T; moment=.T; clock=.T; text='1'; output;
    row_id=27; number=.U; day=.U; moment=.U; clock=.U; text=' A'; output;
    row_id=28; number=.V; day=.V; moment=.V; clock=.V; text='é'; output;
    row_id=29; number=.W; day=.W; moment=.W; clock=.W; text='漢字'; output;
    row_id=30; number=.X; day=.X; moment=.X; clock=.X; text=''; output;
    row_id=31; number=.Y; day=.Y; moment=.Y; clock=.Y; text='01'; output;
    row_id=32; number=.Z; day=.Z; moment=.Z; clock=.Z; text='1'; output;
run;

data work.actual_rows; set incoming.mixed_20261020_012855; format _all_; run;
%compare_rows(work.expected_rows,work.actual_rows,number day moment clock text);
data work.narrow_actual;
    set incoming.narrow_20261020_012855; format _all_;
run;
data work.narrow_expected;
    row_id=1; number=4097; day=3653; output;
    row_id=2; number=0; day=3654; output;
run;
%compare_rows(work.narrow_expected,work.narrow_actual,number day);
proc contents data=incoming.mixed_20261020_012855 out=evidence.mixed_columns; run;
proc contents data=incoming.narrow_20261020_012855 out=evidence.narrow_columns; run;
data _null_; set evidence.narrow_columns;
    if name in ('number','day') and length ne 3 then call execute('%record(Narrow width differs);');
run;
data _null_;
    dsid=open('incoming.empty_20261020_012855','I');
    if dsid then do;
        count=attrn(dsid,'NLOBS'); rc=close(dsid);
        if count ne 0 then call execute('%record(Empty row count differs);');
        else put 'DDIWR_EMPTY_ROWS_PASS';
    end;
    else call execute('%record(Cannot open empty data);');
run;
%put DDIWR_RAW_DIAGNOSTIC_FAILURES=&failures;
/* Reproduce the exported catalog failure independently of FMTSEARCH. */
proc catalog catalog=incoming.mixed_20261020_012855; contents; run; quit;
proc format library=incoming.mixed_20261020_012855 cntlout=work.exported_labels; run;
%put DDIWR_EXPORTED_CATALOG_SYSERR=&syserr;
proc print data=evidence.reference_labels; var fmtname type start end label; run;
