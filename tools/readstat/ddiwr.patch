+readstat_error_t sav_prepare(const char *path, const char *input_encoding, ddiwr_sav_prepared_t *out) {
+    readstat_error_t retval = READSTAT_OK;
+    readstat_parser_t *parser = NULL;
+    readstat_io_t *io = NULL;
+    sav_file_header_record_t header;
+    sav_ctx_t *ctx = NULL;
+    size_t file_size = 0;
+    int i;
+    int index_after_skipping = 0;
+
+    if (out == NULL) {
+        return READSTAT_ERROR_PARSE;
+    }
+    memset(out, 0, sizeof(*out));
+
+    parser = readstat_parser_init();
+    if (parser == NULL) {
+        retval = READSTAT_ERROR_MALLOC;
+        goto cleanup;
+    }
+    if (input_encoding != NULL && *input_encoding != '\0') {
+        parser->input_encoding = input_encoding;
+    }
+    io = parser->io;
+
+    if (io->open(path, io->io_ctx) == -1) {
+        retval = READSTAT_ERROR_OPEN;
+        goto cleanup;
+    }
+
+    file_size = io->seek(0, READSTAT_SEEK_END, io->io_ctx);
+    if (file_size == (size_t) -1) {
+        retval = READSTAT_ERROR_SEEK;
+        goto cleanup;
+    }
+
+    if (io->seek(0, READSTAT_SEEK_SET, io->io_ctx) == -1) {
+        retval = READSTAT_ERROR_SEEK;
+        goto cleanup;
+    }
+
+    if (io->read(&header, sizeof(sav_file_header_record_t), io->io_ctx) < sizeof(sav_file_header_record_t)) {
+        retval = READSTAT_ERROR_READ;
+        goto cleanup;
+    }
+
+    ctx = sav_ctx_init(&header, io);
+    if (ctx == NULL) {
+        retval = READSTAT_ERROR_PARSE;
+        goto cleanup;
+    }
+
+    ctx->input_encoding = input_encoding;
+    ctx->output_encoding = "UTF-8";
+    ctx->user_ctx = NULL;
+    ctx->file_size = file_size;
+
+    sav_parse_timestamp(ctx, &header);
+
+    if ((retval = sav_parse_records_pass1(ctx)) != READSTAT_OK) {
+        goto cleanup;
+    }
+    if ((retval = sav_setup_converter(ctx)) != READSTAT_OK) {
+        goto cleanup;
+    }
+    if (io->seek(sizeof(sav_file_header_record_t), READSTAT_SEEK_SET, io->io_ctx) == -1) {
+        retval = READSTAT_ERROR_SEEK;
+        goto cleanup;
+    }
+    if ((retval = sav_parse_records_pass2(ctx)) != READSTAT_OK) {
+        goto cleanup;
+    }
+    if ((retval = sav_set_n_segments_and_var_count(ctx)) != READSTAT_OK) {
+        goto cleanup;
+    }
+    if ((retval = sav_parse_variable_display_parameter_record(ctx)) != READSTAT_OK) {
+        goto cleanup;
+    }
+
+    for (i = 0; i < ctx->var_index;) {
+        spss_varinfo_t *info = ctx->varinfo[i];
+        ctx->variables[info->index] = spss_init_variable_for_info(info, index_after_skipping, ctx->converter);
+        if (ctx->variables[info->index] == NULL) {
+            retval = READSTAT_ERROR_MALLOC;
+            goto cleanup;
+        }
+        index_after_skipping++;
+        i += info->n_segments;
+    }
+
+    out->parser = parser;
+    out->ctx = ctx;
+    return READSTAT_OK;
+
+cleanup:
+    if (ctx != NULL) {
+        sav_ctx_free(ctx);
+    }
+    if (io != NULL) {
+        io->close(io->io_ctx);
+    }
+    if (parser != NULL) {
+        readstat_parser_free(parser);
+    }
+    return retval;
+}
+
+void sav_prepared_free(ddiwr_sav_prepared_t *prepared) {
+    if (prepared == NULL) {
+        return;
+    }
+    if (prepared->parser != NULL && prepared->parser->io != NULL) {
+        prepared->parser->io->close(prepared->parser->io->io_ctx);
+    }
+    if (prepared->ctx != NULL) {
+        sav_ctx_free(prepared->ctx);
+    }
+    if (prepared->parser != NULL) {
+        readstat_parser_free(prepared->parser);
+    }
+    prepared->parser = NULL;
+    prepared->ctx = NULL;
+}
