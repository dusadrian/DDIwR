+                        if ((status = readstat_write_string(writer, variable)) != READSTAT_OK ||
+                                (status = readstat_write_string(writer, ":")) != READSTAT_OK) {
+                            return status;
+                        }
+                    }
+                    first_variable = 0;
+                }
+                first_attribute = 0;
+                if (pass == 0) {
+                    length += strlen(attribute->name) + 2;
+                    for (i = 0; i < attribute->count; i++) {
+                        length += strlen(attribute->values[i]) + 3;
+                    }
+                    if (length > INT32_MAX) {
