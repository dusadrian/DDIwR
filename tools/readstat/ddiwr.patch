@@ -190,3 +190,13 @@ void dta_ctx_free(dta_ctx_t *ctx);
 
 readstat_error_t dta_type_info(uint16_t typecode, dta_ctx_t *ctx,
         size_t *max_len, readstat_type_t *out_type);
+
+typedef struct ddiwr_dta_prepared_s {
+    readstat_parser_t *parser;
+    dta_ctx_t *ctx;
+    int64_t rows_offset;
+} ddiwr_dta_prepared_t;
+
+readstat_error_t dta_prepare(const char *path, const char *input_encoding, ddiwr_dta_prepared_t *out);
+void dta_prepared_free(ddiwr_dta_prepared_t *prepared);
+const char *dta_lookup_string_ref(dta_ctx_t *ctx, const unsigned char *bytes);
diff --git a/stata/readstat_dta_read.c b/stata/readstat_dta_read.c
index 210d4f9..fa6016e 100644
--- a/stata/readstat_dta_read.c
+++ b/stata/readstat_dta_read.c
@@ -1395,3 +1395,181 @@ cleanup:
 
     return retval;
 }
+
+readstat_error_t dta_prepare(const char *path, const char *input_encoding, ddiwr_dta_prepared_t *out) {
+    readstat_error_t retval = READSTAT_OK;
+    readstat_parser_t *parser = NULL;
+    readstat_io_t *io = NULL;
+    dta_ctx_t *ctx = NULL;
+    size_t file_size = 0;
+    int i;
+
+    if (out == NULL) {
+        return READSTAT_ERROR_PARSE;
+    }
+    memset(out, 0, sizeof(*out));
+
+    parser = readstat_parser_init();
+    if (parser == NULL) {
+        return READSTAT_ERROR_MALLOC;
+    }
+    if (input_encoding != NULL && *input_encoding != '\0') {
+        parser->input_encoding = input_encoding;
+    }
+
+    io = parser->io;
+    ctx = dta_ctx_alloc(io);
+    if (ctx == NULL) {
+        retval = READSTAT_ERROR_MALLOC;
+        goto cleanup;
+    }
+
+    if (io->open(path, io->io_ctx) == -1) {
+        retval = READSTAT_ERROR_OPEN;
+        goto cleanup;
+    }
+
+    {
+        char magic[4];
+        if (io->read(magic, 4, io->io_ctx) != 4) {
+            retval = READSTAT_ERROR_READ;
+            goto cleanup;
+        }
+
+        file_size = io->seek(0, READSTAT_SEEK_END, io->io_ctx);
+        if (file_size == (size_t)-1) {
+            retval = READSTAT_ERROR_SEEK;
+            goto cleanup;
+        }
+        if (io->seek(0, READSTAT_SEEK_SET, io->io_ctx) == -1) {
+            retval = READSTAT_ERROR_SEEK;
+            goto cleanup;
+        }
+
+        if (strncmp(magic, "<sta", 4) == 0) {
+            dta_header64_t header;
+            if ((retval = dta_read_xmlish_header(ctx, &header)) != READSTAT_OK) {
+                goto cleanup;
+            }
+            retval = dta_ctx_init(ctx, header.nvar, header.nobs, header.byteorder, header.ds_format,
+                    parser->input_encoding, "UTF-8");
+        } else {
+            dta_header_t header;
+            if ((retval = dta_read_header(ctx, &header)) != READSTAT_OK) {
+                goto cleanup;
+            }
+            retval = dta_ctx_init(ctx, header.nvar, header.nobs, header.byteorder, header.ds_format,
+                    parser->input_encoding, "UTF-8");
+        }
+        if (retval != READSTAT_OK) {
+            goto cleanup;
+        }
+    }
+
+    ctx->user_ctx = NULL;
+    ctx->file_size = file_size;
+
+    if ((retval = dta_read_label_and_timestamp(ctx)) != READSTAT_OK)
+        goto cleanup;
+    if ((retval = dta_read_tag(ctx, "</header>")) != READSTAT_OK)
+        goto cleanup;
+    if ((retval = dta_read_map(ctx)) != READSTAT_OK)
+        goto cleanup;
+    if ((retval = dta_read_descriptors(ctx)) != READSTAT_OK)
+        goto cleanup;
+
+    for (i = 0; i < ctx->nvar; i++) {
+        size_t max_len;
+        if ((retval = dta_type_info(ctx->typlist[i], ctx, &max_len, NULL)) != READSTAT_OK)
+            goto cleanup;
+        ctx->record_len += max_len;
+    }
+
+    if (ctx->nvar > 0 && ctx->record_len == 0) {
+        retval = READSTAT_ERROR_PARSE;
+        goto cleanup;
+    }
+
+    if ((retval = dta_handle_variables(ctx)) != READSTAT_OK)
+        goto cleanup;
+    if ((retval = dta_read_expansion_fields(ctx)) != READSTAT_OK)
+        goto cleanup;
+
+    if (!ctx->file_is_xmlish) {
+        ctx->data_offset = io->seek(0, READSTAT_SEEK_CUR, io->io_ctx);
+        if (ctx->data_offset == -1) {
+            retval = READSTAT_ERROR_SEEK;
+            goto cleanup;
+        }
+        ctx->value_labels_offset = ctx->data_offset + ctx->record_len * ctx->nobs;
+        out->rows_offset = ctx->data_offset;
+    }
+
+    if ((retval = dta_read_strls(ctx)) != READSTAT_OK)
+        goto cleanup;
+
+    if (ctx->file_is_xmlish) {
+        if (io->seek(ctx->data_offset, READSTAT_SEEK_SET, io->io_ctx) == -1) {
+            retval = READSTAT_ERROR_SEEK;
+            goto cleanup;
+        }
+        if ((retval = dta_read_tag(ctx, "<data>")) != READSTAT_OK) {
+            goto cleanup;
+        }
+        out->rows_offset = io->seek(0, READSTAT_SEEK_CUR, io->io_ctx);
+        if (out->rows_offset == -1) {
+            retval = READSTAT_ERROR_SEEK;
+            goto cleanup;
+        }
+    }
+
+    out->parser = parser;
+    out->ctx = ctx;
+    return READSTAT_OK;
+
+cleanup:
+    if (ctx != NULL) {
+        dta_ctx_free(ctx);
+    }
+    if (io != NULL) {
+        io->close(io->io_ctx);
+    }
+    if (parser != NULL) {
+        readstat_parser_free(parser);
+    }
+    return retval;
+}
+
+void dta_prepared_free(ddiwr_dta_prepared_t *prepared) {
+    if (prepared == NULL) {
+        return;
+    }
+    if (prepared->parser != NULL && prepared->parser->io != NULL) {
+        prepared->parser->io->close(prepared->parser->io->io_ctx);
+    }
+    if (prepared->ctx != NULL) {
+        dta_ctx_free(prepared->ctx);
+    }
+    if (prepared->parser != NULL) {
+        readstat_parser_free(prepared->parser);
+    }
+    prepared->parser = NULL;
+    prepared->ctx = NULL;
+    prepared->rows_offset = 0;
+}
+
+/* Keep parallel workers on the upstream strL reference decoder and comparator. */
+const char *dta_lookup_string_ref(dta_ctx_t *ctx, const unsigned char *bytes) {
+    dta_strl_t key = dta_interpret_strl_vo_bytes(ctx, bytes);
+    dta_strl_t **found = bsearch(&key, ctx->strls, ctx->strls_count,
+            sizeof(dta_strl_t *), &dta_compare_strls);
+
+    if (found != NULL) {
+        return (*found)->data;
+    }
+    if (key.v == 0 && key.o == 0) {
+        return "";
+    }
+
+    return NULL;
+}
