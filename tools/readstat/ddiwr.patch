+            string_set = is_string;
+            if (counted && is_string && strlen(counted) > variable->user_width) {
+                return READSTAT_ERROR_BAD_MR_STRING;
+            }
+        }
+        if (counted && !string_set) {
+            const char *p = counted;
+            if (*p == '-' || *p == '+') {
+                p++;
